# Controle de versão e ambiente local
.git
.gitignore
.gitattributes
.vscode/
.venv/
venv/

# Segredos e banco local — NUNCA vão para a imagem
.env
.env.*
db.sqlite3
*.sqlite3

# Artefatos que o container regenera no entrypoint
staticfiles/

# Uploads locais (em produção é volume)
media/

# Planejamento, exports e dados volumosos que não pertencem à imagem
tasks/
export_folheto/
*.xlsx
*.log

# Exceção: as planilhas-fonte de base_datas/ (~6MB) PRECISAM entrar na imagem —
# são a entrada dos comandos de import (01..09), que rodam dentro do container.
# Sem isto, o reimport exigiria um `docker compose cp` manual a cada carga de dados.
!base_datas/

# Caches Python
__pycache__/
*.pyc
*.pyo
*.pyd
